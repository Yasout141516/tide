{
  "name": "tide",
  "version": "1.0.0",
  "description": "Tide: offline PDF read-aloud app",
  "main": "./out/main/index.js",
  "author": "Yasout141516",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "package": "electron-vite build && electron-builder --publish never",
    "test": "vitest run",
    "e2e": "playwright test",
    "fetch-model": "node scripts/fetch-model.mjs",
    "spoken-text": "tsx scripts/spoken-text.ts",
    "voice-samples": "tsx scripts/voice-samples.ts",
    "voice-previews:render": "tsx scripts/voice-previews.ts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@huggingface/transformers": "3.8.1",
    "ffmpeg-static": "5.3.0",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.21.0",
    "phonemizer": "1.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "29.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "^5.1.0"
  },
  "productName": "Tide",
  "license": "GPL-3.0-only"
}
